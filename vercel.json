{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://novacart-api-j9um.onrender.com/api/:path*"
    }
  ],
  "routes": [
    {
      "src": "/api/:path*",
      "dest": "https://novacart-api-j9um.onrender.com/api/:path*"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
