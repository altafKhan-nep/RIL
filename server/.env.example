# ===========================================
# Life In Pieces Server Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/novacart

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Stripe (optional - server works without it, just no Stripe payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# CORS Origins (comma-separated, used by frontend)
# FRONTEND_URL=http://localhost:5173

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=5000
# LOGIN_RATE_LIMIT_MAX=10
# ORDER_RATE_LIMIT_MAX=20

# Request Size Limit (bytes)
# MAX_REQUEST_SIZE=102400

# Logging
# LOG_LEVEL=combined

# --- Session cookies ---
# The browser app authenticates with an httpOnly cookie; nothing is stored in JS.
# The access JWT is intentionally short-lived; the refresh cookie is opaque and
# server-side revocable, so logout actually kills a stolen session.
# ACCESS_TOKEN_EXPIRE=15m
# REFRESH_TOKEN_EXPIRE=30d
# SESSION_PRUNE_INTERVAL_MS=21600000
# AUTH_COOKIE_NAME=lip_token
# REFRESH_COOKIE_NAME=lip_refresh
# Cross-origin API hosts require SameSite=None (HTTPS only):
# AUTH_COOKIE_SAMESITE=none

# --- Uploads ---
# Point this at a persistent volume on ephemeral hosts (e.g. Render), otherwise
# uploaded images are lost on every deploy.
# UPLOAD_DIR=/var/data/uploads
