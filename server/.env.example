# ===========================================
# NovaCart Server Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/novacart

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Stripe (optional - server works without it, just no Stripe payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# CORS Origins (comma-separated, used by frontend)
# FRONTEND_URL=http://localhost:5173

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=5000
# LOGIN_RATE_LIMIT_MAX=10
# ORDER_RATE_LIMIT_MAX=20

# Request Size Limit (bytes)
# MAX_REQUEST_SIZE=102400

# Logging
# LOG_LEVEL=combined
