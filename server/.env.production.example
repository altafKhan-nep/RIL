# ===========================================
# NovaCart Production Environment Variables
# ===========================================
# Copy this to .env on your VPS and fill in values

# Server
PORT=5001
NODE_ENV=production

# MongoDB (Atlas or local)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/novacart?appName=Cluster0

# JWT Authentication (generate a strong random string)
JWT_SECRET=your_super_secret_random_string_here_min_32_chars
JWT_EXPIRE=7d

# Stripe (optional)
STRIPE_SECRET_KEY=sk_live_your_stripe_key

# Frontend URL (for CORS - your domain or IP)
FRONTEND_URL=http://YOUR_DOMAIN_OR_IP

# Vite build env (set during build, not at runtime)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key
# VITE_API_URL=/api
